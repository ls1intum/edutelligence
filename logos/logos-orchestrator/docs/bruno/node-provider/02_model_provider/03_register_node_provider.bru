meta {
  name: Register LogosWorkerNode Provider
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/logosdb/providers/logosnode/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "logos_key": "{{logosKey}}",
    "provider_name": "{{providerName}}",
    "base_url": "",
    "privacy_level": "LOCAL"
  }
}

docs {
  privacy_level is required, with no default. LOCAL means hardware you operate;
  use THIRD_PARTY_HARDWARE for a rented GPU or a personal machine running the
  MLX worker, whose owner can inspect the running processes. Registering such a
  node as LOCAL makes it eligible for requests restricted to operator-controlled
  hardware.
}
