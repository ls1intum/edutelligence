<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Persistent EWMA state for the orchestrator's dynamic scheduler.

         Each row stores one EWMA keyed by (model_name, provider_id, tier).
         'tier' is either a ReadinessTier value ('cold', 'sleeping', …) for
         load/wake overhead, or one of the literal strings
           'ttft'              — decode-only first-token time
           'e2e'               — end-to-end request latency
           'prefill_per_token' — prompt-ingestion rate in seconds / input token
         The real provider_id is always stored.

         The orchestrator loads all rows on startup and upserts on every new
         observation so the learned values survive restarts. -->
    <changeSet id="019-latency-observations" author="logos">
        <sql>
            CREATE TABLE latency_observations (
                id          SERIAL PRIMARY KEY,
                model_name  TEXT    NOT NULL,
                provider_id INTEGER NOT NULL,
                tier        TEXT    NOT NULL,
                ewma_value  DOUBLE PRECISION NOT NULL,
                n           INTEGER NOT NULL DEFAULT 1,
                updated_at  TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

                CONSTRAINT uq_latency_observations UNIQUE (model_name, provider_id, tier)
            );

            CREATE INDEX idx_latency_observations_model
                ON latency_observations (model_name);
        </sql>
        <rollback>
            <sql>DROP TABLE IF EXISTS latency_observations;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
