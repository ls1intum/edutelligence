<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Public stats opt-in: only teams an admin selects in team settings
         appear on /public/stats. Default false so nothing is published until
         someone turns the flag on. Totals on that page are scoped to the same
         set (never leak names or counts of non-selected teams). -->
    <changeSet id="057-team-show-on-public-stats" author="logos">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="teams" columnName="show_on_public_stats"/></not>
        </preConditions>
        <addColumn tableName="teams">
            <column name="show_on_public_stats" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="teams" columnName="show_on_public_stats"/>
        </rollback>
    </changeSet>

    <!-- Every public stats figure comes from one pass over the successful
         rows of opted-in teams (LogEntryRepository#findPublicUsageRows). This
         partial index carries every column that pass reads, so it runs as an
         index-only scan (~60 MB) instead of reading the log_entry heap, which
         the request payloads make about a gigabyte on production. Measured on
         production data: ~2.4 s to ~1.0 s. CONCURRENTLY so writers are not
         blocked while logos-webservice is redeployed. -->
    <changeSet id="057-log-entry-public-stats-index" author="logos" runInTransaction="false">
        <preConditions onFail="MARK_RAN">
            <not><indexExists tableName="log_entry" indexName="idx_log_entry_public_stats"/></not>
        </preConditions>
        <sql>
            CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_log_entry_public_stats
                ON log_entry (team_id, timestamp_request)
                INCLUDE (id, user_id, api_key_id, provider_id, model_id, model_name)
                WHERE result_status = 'success';
        </sql>
        <rollback>
            <sql>DROP INDEX CONCURRENTLY IF EXISTS idx_log_entry_public_stats;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
