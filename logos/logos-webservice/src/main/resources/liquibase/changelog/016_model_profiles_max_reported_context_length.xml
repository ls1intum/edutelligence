<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- The model_profiles table only persisted the operator-pinned
         max_context_length, which is NULL for calibrated models — the width
         they actually run at lives in calibration_max_model_len and the KV
         sweep pairs, neither of which had a column. The orchestrator's view
         of a model's context therefore existed only in the live worker
         runtime snapshots: every workernode going offline wiped it from
         /v1/models and clients fell back to a guessed window (#829).

         The new column is the durable half of that fix: a historic maximum,
         the widest context any worker has ever reported for the model. The
         orchestrator's upsert_model_profiles maintains it as a high-water
         mark (GREATEST of stored and freshly derived, never shrinking), and
         /v1/models reports it as max_model_len_overall so the number
         survives every workernode going offline and an orchestrator
         restart. Nullable: rows written before this changeSet hold NULL.
         The backfill changeSet below settles the mark for operator-pinned
         models immediately; calibrated-only models settle it on their next
         worker snapshot. -->
    <changeSet id="016-model-profiles-max-reported-context-length" author="wasnertobias">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="model_profiles" columnName="max_reported_context_length"/></not>
        </preConditions>
        <addColumn tableName="model_profiles">
            <column name="max_reported_context_length" type="INTEGER"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="model_profiles" columnName="max_reported_context_length"/>
        </rollback>
    </changeSet>

    <!-- One-shot backfill for rows that pre-date the column: operator-pinned
         models (max_context_length > 0) take the pinned value as their
         historic mark, so the all-offline fallback works for them the moment
         the migration has run, without waiting for a worker snapshot.
         Calibrated-only models (max_context_length NULL) cannot be recovered
         here — calibration_max_model_len and the KV sweep pairs were never
         persisted to this table, so those need one worker check-in. The
         WHERE clause makes the changeSet a no-op once the marks have
         settled, so it is safe to keep in the change log. -->
    <changeSet id="016-model-profiles-max-reported-context-length-backfill" author="wasnertobias">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="model_profiles" columnName="max_reported_context_length"/>
        </preConditions>
        <update tableName="model_profiles">
            <column name="max_reported_context_length" valueComputed="max_context_length"/>
            <where>max_reported_context_length IS NULL AND max_context_length &gt; 0</where>
        </update>
    </changeSet>

</databaseChangeLog>
