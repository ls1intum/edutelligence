<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- LogEntryBillingRepository filters log_entry by a timestamp_request range for
         the Billing/Statistics dashboards. The range predicate is sargable, but with
         no index on timestamp_request Postgres has nothing to seek with, so every
         dashboard load scans the entire log_entry table regardless of how narrow the
         requested window is; it only gets worse as log_entry grows. -->
    <changeSet id="008-log-entry-timestamp-request-index" author="alexandra">
        <preConditions onFail="MARK_RAN">
            <not><indexExists tableName="log_entry" indexName="idx_log_entry_timestamp_request"/></not>
        </preConditions>
        <createIndex tableName="log_entry" indexName="idx_log_entry_timestamp_request">
            <column name="timestamp_request"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
