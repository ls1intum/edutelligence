<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Direct-cloud successes whose price is not stored yet.

         GatewayCloudAccounting.settleSuccess stores the price of a successful
         direct-cloud request on its row (cost_finalized = TRUE), and
         GatewayCloudAccounting.finalizeUnsettled sweeps, on a schedule on
         every replica, the successful gw- rows that settled without one. Such
         a row would otherwise be re-priced by the log_entry_cost view on
         every read, which makes every budget refresh grow with the key's
         month of traffic.

         Without this index the sweep is a scan of the whole table. With it,
         the sweep is proportional to the rows still unpriced: a backlog once,
         then next to nothing.

         The predicate is spelled exactly as in the sweep: PostgreSQL uses a
         partial index only when it can see the query's WHERE clause implies
         the index predicate, and for LIKE that means textual match.

         Runs outside a transaction so CONCURRENTLY can build without locking
         log_entry against the logos-orchestrator, which keeps writing to this
         table while logos-webservice is redeployed (same rationale as 043). -->
    <changeSet id="060-log-entry-gateway-unfinalized-index" author="logos" runInTransaction="false">
        <preConditions onFail="MARK_RAN">
            <not><indexExists tableName="log_entry" indexName="idx_log_entry_gateway_unfinalized"/></not>
        </preConditions>
        <sql>
            CREATE INDEX CONCURRENTLY idx_log_entry_gateway_unfinalized
                ON log_entry (id)
                WHERE result_status = 'success' AND cost_finalized = FALSE AND request_id LIKE 'gw-%';
        </sql>
        <rollback>
            <sql>DROP INDEX CONCURRENTLY IF EXISTS idx_log_entry_gateway_unfinalized;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
