<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- LogEntryRepository.findLatestRequests backs the statistics request feed,
         which StatsV2WebSocketHandler pushes every 2 s for every open statistics
         session. log_entry carried no index on any of its timestamps, so finding
         the newest ten rows meant reading and sorting the whole selected range
         (30 days by default) on every push - and paying the query's two
         correlated LATERALs over the sorted set rather than over ten rows.

         The column list mirrors that query's ORDER BY exactly. Postgres matches
         sort orderings by their nulls flag rather than reasoning about the NOT
         NULL constraint, so an index whose nulls placement differs from the
         query's would silently not serve the ordering and the sort would happen
         anyway - the two have to be kept in step. Both are plain DESC here
         (NULLS FIRST by default), which is why findLatestRequests must not
         reintroduce a NULLS LAST it does not need: timestamp_request is NOT
         NULL.

         The second column is what the keyset cursor compares against:
         findLatestRequests pages with (timestamp_request, request_id) <
         (:cursorTs, :cursorId), which this index answers as a seek rather than
         a scan, at any depth.

         Partial on request_id IS NOT NULL, which the query requires and which
         keeps rows that never became a routed request out of the index.

         CONCURRENTLY (and so runInTransaction="false"): log_entry takes a row
         per request, and this must not lock it against live traffic while the
         index builds on an already-populated database. -->
    <changeSet id="012-log-entry-request-feed-index" author="tobias" runInTransaction="false">
        <preConditions onFail="MARK_RAN">
            <not><indexExists tableName="log_entry" indexName="idx_log_entry_request_feed"/></not>
        </preConditions>
        <sql>
            CREATE INDEX CONCURRENTLY idx_log_entry_request_feed
                ON log_entry (timestamp_request DESC, request_id DESC)
                WHERE request_id IS NOT NULL;
        </sql>
        <rollback>
            <sql>DROP INDEX CONCURRENTLY IF EXISTS idx_log_entry_request_feed;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
