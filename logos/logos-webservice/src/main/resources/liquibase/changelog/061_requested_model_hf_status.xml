<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Hugging Face verdict for a requested model.

         The precheck at submission asks the orchestrator whether the central
         HF_TOKEN can see the repository; this column records the last decisive
         answer (reachable/rejected). No verdict yet — the check was never run,
         or it timed out — stays NULL: a timeout is a statement about the
         check, not about the model, so it is not stored and the row is simply
         checked again next time. Rows that predate the precheck are backfilled
         by a sweep at application start. -->
    <changeSet id="061-requested-model-hf-status" author="maltebai">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="requested_models" columnName="hugging_face_status"/></not>
        </preConditions>
        <addColumn tableName="requested_models">
            <column name="hugging_face_status" type="VARCHAR(32)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <sql><![CDATA[
            -- Only decisive verdicts are stored; see the changeSet comment.
            ALTER TABLE requested_models
                ADD CONSTRAINT ck_requested_models_hf_status
                CHECK (hugging_face_status IN ('reachable', 'rejected'));
        ]]></sql>
        <rollback>
            <sql>
                ALTER TABLE requested_models DROP CONSTRAINT IF EXISTS ck_requested_models_hf_status;
            </sql>
            <dropColumn tableName="requested_models" columnName="hugging_face_status"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
