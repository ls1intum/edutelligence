{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "groupName": "athena",
      "matchFileNames": ["athena/**"],
      "commitMessagePrefix": "`Athena`:"
    },
    {
      "groupName": "atlas",
      "matchFileNames": ["atlas/**"],
      "commitMessagePrefix": "`Atlas`:"
    },
    {
      "groupName": "hyperion",
      "matchFileNames": ["hyperion/**"],
      "commitMessagePrefix": "`Hyperion`:"
    },
    {
      "groupName": "iris",
      "matchFileNames": ["iris/**"],
      "commitMessagePrefix": "`Iris`:"
    },
    {
      "description": "tiktoken (via PyO3 0.22) does not build on Python 3.14 yet",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.14"
    }
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["* 0-4 * * *"],
  "updateNotScheduled": false
}
