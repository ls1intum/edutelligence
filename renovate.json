{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "groupName": "athena",
      "matchFileNames": ["athena/**"],
      "commitMessagePrefix": "`Athena`:"
    },
    {
      "groupName": "atlas",
      "matchFileNames": ["atlas/**"],
      "commitMessagePrefix": "`Atlas`:"
    },
    {
      "groupName": "hyperion",
      "matchFileNames": ["hyperion/**"],
      "commitMessagePrefix": "`Hyperion`:"
    },
    {
      "groupName": "iris",
      "matchFileNames": ["iris/**"],
      "commitMessagePrefix": "`Iris`:"
    },
    {
      "groupName": "logos",
      "matchFileNames": ["logos/**"],
      "commitMessagePrefix": "`Logos`:"
    },
    {
      "groupName": "memiris",
      "matchFileNames": ["memiris/**"],
      "commitMessagePrefix": "`Memiris`:"
    },
    {
      "groupName": "shared",
      "matchFileNames": ["shared/**"],
      "commitMessagePrefix": "`Shared`:"
    },
    {
      "description": "tiktoken (via PyO3 0.22) does not build on Python 3.14 yet",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.14"
    },
    {
      "description": "logos-webservice ships mvnw without .mvn/wrapper, so Renovate cannot regenerate it",
      "matchManagers": ["maven-wrapper"],
      "enabled": false
    }
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["* 0-4 * * *"],
  "updateNotScheduled": false
}
